<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- to know whether the connection is metered (songs are only downloaded ahead on one that is not) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- the media notification and keeping music going with the screen off -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- the player that floats over other apps while music plays (asked for from settings) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.app"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
        </activity>

        <!-- the launcher icon in each of twelve colors. exactly one is enabled, and the
             app switches which one to follow the theme color (NativeBridge.setLauncherIcon).
             the activity itself no longer has the launcher entry -->
        <activity-alias
            android:name=".Icon00"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_00"
            android:roundIcon="@mipmap/ic_launcher_00"
            android:label="@string/main_activity_title"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon01"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_01"
            android:roundIcon="@mipmap/ic_launcher_01"
            android:label="@string/main_activity_title"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
