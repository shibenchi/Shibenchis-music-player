<?xml version="1.0" encoding="utf-8"?>
<!-- android blocks plain http by default. the social server is reached over https
     now, and the on-device audio helper listens on the phone's own loopback
     address, so only those two local hosts are allowed plain http and everything
     else stays https only -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
