{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "miniplayer"
  ],
  "permissions": [
    "core:default",
    "allow-toggle-miniplayer",
    "allow-frontend-log",
    "allow-apply-shortcut-prefs",
    "core:window:allow-start-dragging",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-file",
    "fs:allow-exists",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$DOWNLOAD/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$DOWNLOAD/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$DOWNLOAD/**" }]
    }
  ],
  "remote": {
    "urls": ["http://localhost:3001/*"]
  }
}
