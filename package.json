{
  "name": "shibenchi-music-player",
  "version": "1.3.2",
  "description": "Shibenchi Music Player is a music player and downloader built for local listening, playlists, and queue management.",
  "proxy": "http://localhost:3001",
  "scripts": {
    "start": "cross-env PORT=3001 node server/index.js",
    "server": "cross-env PORT=3001 NODE_ENV=development node server/index.js",
    "helper": "cross-env LOCAL_HELPER=1 LOCAL_HELPER_PORT=3002 node server/index.js",
    "react-start": "cross-env PORT=3000 react-scripts start",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run react-start\"",
    "dev:server": "npm run server",
    "dev:react": "npm run react-start",
    "build": "react-scripts build",
    "repair:native": "node scripts/ensure-better-sqlite3.js",
    "install:clean": "rimraf node_modules package-lock.json && npm install",
    "postinstall": "node scripts/ensure-better-sqlite3.js",
    "desktop-dev": "tauri dev",
    "desktop-build": "tauri build"
  },
  "keywords": [
    "music",
    "streaming",
    "downloader",
    "youtube"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.18.4",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.3.0",
    "howler": "^2.2.4",
    "node-fetch": "^2.7.0",
    "play-dl": "^1.9.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "ws": "^8.20.0",
    "yt-dlp-exec": "^1.0.2",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "bootstrap": "^5.3.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "react-bootstrap": "^2.9.1",
    "rimraf": "^5.0.5",
    "typescript": "^4.9.5",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
